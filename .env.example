# =============================================================================
# kernel-evolving — environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values. `start.sh` sources `.env`
# automatically. Every variable below is read from the environment at runtime.
#
# Provider routing can ALSO be set in `config.yaml` under `providers.*` — the
# env vars here override the config file at runtime.
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram (required for the bot / control plane)
# -----------------------------------------------------------------------------
# Bot token from @BotFather. Without it the Telegram bot is disabled.
KERNEL_EVO_TELEGRAM_BOT_TOKEN=your_bot_token_here
# Allowed chat id — only this chat may talk to the agent.
KERNEL_EVO_TELEGRAM_CHAT_ID=your_chat_id_here
# User identity default (used by the Docker image to seed user.json).
KERNEL_USER_NAME=YourName
KERNEL_USER_HANDLE=yourhandle


# -----------------------------------------------------------------------------
# AI providers — API keys (at least one cloud provider recommended for Tier 2)
# -----------------------------------------------------------------------------
# OpenAI — used for openai provider + fallback synthesis.
OPENAI_API_KEY=
# Temporary/alias OpenAI key (alternate key used by some scripts).
TMP_OPEN_AI_API_KEY=
# Anthropic — used for anthropic provider.
ANTHROPIC_API_KEY=
# GitHub token — used for copilot provider + auto-update (KERNEL_EVO_GITHUB_REPO).
GITHUB_TOKEN=
# GitHub Copilot dedicated token (falls back to GITHUB_TOKEN for copilot provider).
GITHUB_COPILOT_TOKEN=
# Hugging Face token — used for hf provider + HF dataset uploads (trajectories).
HF_TOKEN=
# Inference provider used by the HF Router for the hf provider. The router
# endpoint is https://router.huggingface.co/v1 and the provider is selected by a
# ":{provider}" suffix on the model id (e.g. ":deepinfra"). Default: deepinfra
# (cheapest provider serving DeepSeek-V4-Flash-0731).
# HF_ROUTER_PROVIDER=deepinfra
# OpenRouter — used for openrouter provider (deepseek-v4-flash etc.).
OPENROUTER_API_KEY=


# -----------------------------------------------------------------------------
# Provider routing overrides (override config.yaml `providers.*` at runtime)
# -----------------------------------------------------------------------------
# Valid values: local | openai | anthropic | hf | copilot | openrouter
# `local` loads Nemotron into VRAM (resource heavy); any cloud value skips the
# local model server entirely (no VRAM). Default when unset: local.
PROVIDER_TASK_INFERENCE=hf
# Same override pattern applies to the other inference roles:
#   PROVIDER_SYNTHESIS=           # Tier 2 skill synthesis
#   PROVIDER_CRITIC=              # critic evaluation
#   PROVIDER_PLANNING=            # micro-planner
#   PROVIDER_TRAJECTORY_TEACHER=  # trajectory fine-tune teacher


# -----------------------------------------------------------------------------
# Local / cloud model server
# -----------------------------------------------------------------------------
# Force the local model server to start even when task_inference is cloud.
# Useful only if you need STT/voice while routing chat to the cloud. NOTE: this
# loads the model into VRAM and defeats a cloud-only, resource-light setup.
# KERNEL_EVO_FORCE_LOCAL=1
# Model source: local (default) or docker-hub (pull MODEL_ID from HF hub).
# MODEL_SOURCE=local
# Model id/repo to load when MODEL_SOURCE=docker-hub (e.g. nvidia/Nemotron-Labs-Diffusion-3B).
# MODEL_ID=nvidia/Nemotron-Labs-Diffusion-3B
# Path to a fine-tuned LoRA adapter to apply on top of the base model.
# MODEL_ADAPTER_PATH=
# Override the Unix socket path the model client connects to.
# MODEL_SERVER_SOCKET=/tmp/kernel_evolving_model.sock
# Override the audio-slot model path (default from config model_slots.audio).
# KERNEL_AUDIO_MODEL_PATH=
# Override the embedding model path (default from config embedding_model_path).
# KERNEL_EMBEDDING_MODEL_PATH=
# Debug: print the two-stage tool-call routing traces (1 = on).
# KERNEL_EVO_DEBUG_TWO_STAGE=0


# -----------------------------------------------------------------------------
# Model cache (host path mounted into /models in container)
# -----------------------------------------------------------------------------
# MODELS_PATH=/path/to/your/huggingface/cache
# HF cache dir (default ~/.cache/huggingface). Also used to resolve model snapshots.
# HF_HOME=
# Alt HF cache dir (fallback if HF_HOME unset).
# TRANSFORMERS_CACHE=


# -----------------------------------------------------------------------------
# Evolution system
# -----------------------------------------------------------------------------
# Master switch for the autonomous skill-evolution loop (true/false).
EVOLUTION_ENABLED=false
# Max evolution iterations per cycle before stopping (default 10).
# EVOLUTION_MAX_ITERATIONS=10
# Skip the local Telegram approval gate for Tier 2 skill installs (true/false).
# TIER2_APPROVAL_SKIP_LOCAL=false
# GitHub allowlist prefix for skill/ecosystem repos (default https://github.com/).
# KERNEL_GH_ALLOWLIST_PREFIX=https://github.com/
# GitHub org allowlist for ecosystem skills (default fabiopacifici-bot).
# KERNEL_GH_ALLOWLIST_ORG=fabiopacifici-bot


# -----------------------------------------------------------------------------
# Goal discovery (ADR-009)
# -----------------------------------------------------------------------------
# Seconds between background goal-discovery scans (default 300).
# DISCOVERY_INTERVAL_S=300
# Recurrence hits before a pattern is promoted to an evolution task (default 3).
# DISCOVERY_THRESHOLD=3
# Max patterns seeded at boot (default 3).
# DISCOVERY_BOOT_CAP=3


# -----------------------------------------------------------------------------
# Runtime paths / workspaces
# -----------------------------------------------------------------------------
# Override the agent workspace root (default ~/.kernel-evolving/workspace).
# KERNEL_WORKSPACE=
# Override the skills directory (default from config skills_dir).
# SKILLS_DIR=
# Override the routines directory (default from config routines_dir).
# ROUTINES_DIR=
# Docker: host dir mounted into /app/workspace (default ~/.kernel-evolving/workspace).
# KERNEL_WORKSPACE_PATH=~/.kernel-evolving/workspace

# Machine-specific model/hub paths referenced from config.yaml via ${VAR}.
# config.yaml uses ${KERNEL_EVO_HF_HUB}, ${KERNEL_EVO_HF_CACHE} and
# ${KERNEL_EVO_NEVERSLAVE_POSTS}; set these to your local paths so the
# committed config stays portable. Leave unset to use the raw placeholder.
# Base dir of your local HuggingFace model snapshots (e.g. ~/models/huggingface).
# KERNEL_EVO_HF_HUB=~/models/huggingface
# HF cache dir for models downloaded by the transformers cache (default ~/.cache/huggingface/hub).
# KERNEL_EVO_HF_CACHE=~/.cache/huggingface/hub
# Absolute path to the neverslave.com posts data dir (paths.NEVERSLAVE_POSTS).
# KERNEL_EVO_NEVERSLAVE_POSTS=~/Projects/neverslave.com/assets/data/posts
# Override the Gemma-4-E2B model path used by scripts/finetune_from_trajectories.py.
# KERNEL_EVO_E2B_MODEL=~/models/huggingface/hub/models--google--gemma-4-E2B-it


# -----------------------------------------------------------------------------
# Database path overrides (test isolation / redirection)
# -----------------------------------------------------------------------------
# Convention: KERNEL_<NAME>_DB. Each redirects one SQLite DB to an alternate path.
# KERNEL_MEMORY_DB=            # chat history
# KERNEL_LONG_TERM_DB=         # long-term memory store
# KERNEL_EVOLUTION_DB=         # evolution state
# KERNEL_SIGNALS_DB=           # promoted signals
# KERNEL_FAILED_REQ_DB=        # failed requests
# KERNEL_PROBES_DB=            # observer probes
# KERNEL_SYSLOG_DB=            # system debug log
# KERNEL_CONVERSATIONS_DB=     # conversations
# KERNEL_PROMPT_LOG_DB=        # prompt log


# -----------------------------------------------------------------------------
# Voice / audio
# -----------------------------------------------------------------------------
# Path to the voice-activity state file (default ~/.kernel-evolving/workspace/tmp/voice_activity.json).
# KERNEL_VOICE_ACTIVITY_FILE=
# Directory of cloned voice samples (default from config).
# KERNEL_VOICE_SAMPLES_DIR=
# Default voice sample file used for voice cloning (default fabio-en-phonetic.wav).
# KERNEL_DEFAULT_VOICE_SAMPLE=
# External voice-server base URL (TTS/STT) — overrides config services.voice_server.url.
# VOICE_SERVER_URL=
# Timeout (seconds) for voice chat triage (default 60).
# VOICE_CHAT_TRIAGE_TIMEOUT_S=60


# -----------------------------------------------------------------------------
# Networking / endpoints
# -----------------------------------------------------------------------------
# OpenClaw (Olly) endpoint for escalation (default http://localhost:18789).
# OPENCLAW_ENDPOINT=http://localhost:18789
# Alias used by code_synthesizer for the OpenClaw URL.
# OPENCLAW_URL=http://localhost:18769
# Multi-agent collective-memory service URL (config collective_memory.url).
# KERNEL_EVO_COLLECTIVE_MEMORY_URL=http://localhost:8010


# -----------------------------------------------------------------------------
# Auto-update (infra/updater.py)
# -----------------------------------------------------------------------------
# Override the GitHub repo used for /update (default fabiopacifici-bot/kernel-evolving).
# KERNEL_EVO_GITHUB_REPO=fabiopacifici-bot/kernel-evolving
# Override the releases API URL (default derived from KERNEL_EVO_GITHUB_REPO).
# KERNEL_EVO_RELEASES_URL=https://api.github.com/repos/<owner>/<repo>/releases/latest
# Override the tags API URL (default derived from KERNEL_EVO_GITHUB_REPO).
# KERNEL_EVO_TAGS_URL=https://api.github.com/repos/<owner>/<repo>/tags


# -----------------------------------------------------------------------------
# CLI / misc
# -----------------------------------------------------------------------------
# `eva` CLI: override the API base URL for remote access (default http://localhost:8779).
# EVA_API=http://localhost:8779
# SIM_MODE=true bypasses the exec_shell approval gate (used for trajectory collection).
# SIM_MODE=false
# Temp dir for the model server (forced to /tmp if not under /tmp).
# TMPDIR=/tmp

# --- Vision eyes (config.yaml `vision.eyes` placeholders) ---
# Eye 1 (left) — XIAO/YOLOv8n brain (object_face)
# KERNEL_EVO_EYE_LEFT_BASE=http://<hub-ip>:5010
# KERNEL_EVO_EYE_LEFT_STREAM=http://<xiao-ip>:80/stream
# Eye 2 (right) — Pi webcam/leaf brain (plant_health)
# KERNEL_EVO_EYE_RIGHT_BASE=http://<hub-ip>:5000
# KERNEL_EVO_EYE_RIGHT_STREAM=http://<hub-ip>:5000/video_feed

# --- Sensors (config.yaml `sensors` placeholders) ---
# Pi sensor endpoint (temp/humi/moisture via /pico/sensors)
# KERNEL_EVO_SENSORS_PI_BASE=http://<hub-ip>:5000