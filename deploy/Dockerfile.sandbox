FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY src/ ./src/
COPY config.container.yaml config.yaml
# EVOLUTION_ENABLED=true by default in sandbox
ENV EVOLUTION_ENABLED=true
ENV KERNEL_SANDBOX=true
# No Telegram bot in sandbox — API only
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8779"]
