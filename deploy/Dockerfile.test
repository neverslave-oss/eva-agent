FROM python:3.13-slim
WORKDIR /app

# Test-only requirements — no torch/transformers (model not loaded in tests)
RUN pip install --no-cache-dir \
    fastapi>=0.110.0 \
    uvicorn>=0.27.0 \
    pydantic>=2.0.0 \
    pyyaml>=6.0 \
    requests>=2.31.0 \
    pytest>=8.0.0 \
    pytest-mock>=3.14.0 \
    psutil>=5.9.0

COPY src/ ./src/
COPY tests/ ./tests/
COPY config.yaml .
COPY pyproject.toml .

ENV EVOLUTION_ENABLED=true
ENV KERNEL_SANDBOX=true
ENV PYTHONPATH=/app/src

CMD ["python3", "-m", "pytest", "tests/test_evolver.py", "-v", "--tb=short", "--no-header"]
