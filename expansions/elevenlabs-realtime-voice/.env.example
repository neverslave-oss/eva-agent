# ElevenLabs Realtime Voice — environment example (never commit real secrets)
# Copy to .env and fill in.

# Required
ELEVENLABS_API_KEY=your_key_here

# For the realtime / conversational agents channel (provision on the dashboard)
ELEVENLABS_AGENT_ID=

# Default voice for the streaming TTS path (a voice_id from your account)
ELEVENLABS_DEFAULT_VOICE_ID=

# Server port (default 8767 — keeps clear of Olly voice server on 8766)
ELEVENLABS_RT_PORT=8767