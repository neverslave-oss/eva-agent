# ── HTTP ─────────────────────────────────────────────────────────────────────

def _get(path: str, timeout: int = 8) -> dict:
    url = f"{API_BASE}{path}"
    with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as r:
        return json.loads(r.read())


def _post(path: str, body: dict = None, timeout: int = 120) -> dict:
    url = f"{API_BASE}{path}"
    data = json.dumps(body or {}).encode()
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _alive() -> bool:
    try:
        _get("/health", timeout=3)
        return True
    except Exception:
        return False


def _require_running():
    if not _alive():
        print(f"\033[91m  EVA not running at {API_BASE}\033[0m")
        print(f"  Start with:  bash {REPO_DIR}/start.sh")
        print(f"  Or override: EVA_API=http://host:8779 eva\n")
        return False
    return True

