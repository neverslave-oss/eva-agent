def cmd_telegram():
    """Guided Telegram bot configuration."""
    print(f"\n\033[96m  Telegram Channel Setup\033[0m")
    print(f"  Config file: {ENV_FILE}\n")

    # Read existing values
    env_vars = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                env_vars[k.strip()] = v.strip()

    current_token = env_vars.get("KERNEL_EVO_TELEGRAM_BOT_TOKEN", "")
    current_chat  = env_vars.get("KERNEL_EVO_TELEGRAM_CHAT_ID", "")

    token_hint = f"(current: ...{current_token[-8:]})" if current_token else "(not set)"
    chat_hint  = f"(current: {current_chat})" if current_chat else "(not set)"

    print(f"  \033[90mYou need a Telegram bot token and your chat ID.\033[0m")
    print(f"  \033[90mCreate a bot at https://t.me/BotFather → /newbot\033[0m")
    print(f"  \033[90mGet your chat ID by messaging @userinfobot\033[0m\n")

    try:
        new_token = input(f"  Bot token {token_hint}: ").strip()
        new_chat  = input(f"  Chat ID   {chat_hint}: ").strip()
    except (KeyboardInterrupt, EOFError):
        print("\n  Cancelled.\n")
        return

    if not new_token and not current_token:
        print("  \033[91mNo token provided — nothing saved.\033[0m\n")
        return

    # Use existing values if blank
    final_token = new_token or current_token
    final_chat  = new_chat  or current_chat

    # Validate token by calling Telegram getMe
    print(f"\n  Validating token...")
    try:
        url = f"https://api.telegram.org/bot{final_token}/getMe"
        with urllib.request.urlopen(url, timeout=8) as r:
            data = json.loads(r.read())
        if data.get("ok"):
            bot = data["result"]
            print(f"  \033[92m✓ Bot verified: @{bot['username']} ({bot['first_name']})\033[0m")
        else:
            print(f"  \033[91m✗ Token invalid: {data}\033[0m")
            confirm = input("  Save anyway? [y/N]: ").strip().lower()
            if confirm != "y":
                return
    except Exception as e:
        print(f"  \033[93m⚠ Could not validate (no internet?): {e}\033[0m")
        confirm = input("  Save anyway? [y/N]: ").strip().lower()
        if confirm != "y":
            return

    # Write .env
    env_vars["KERNEL_EVO_TELEGRAM_BOT_TOKEN"] = final_token
    if final_chat:
        env_vars["KERNEL_EVO_TELEGRAM_CHAT_ID"] = final_chat

    lines = []
    keys_written = set()
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k = line.partition("=")[0].strip()
                if k in env_vars:
                    lines.append(f"{k}={env_vars[k]}")
                    keys_written.add(k)
                else:
                    lines.append(line)
            else:
                lines.append(line)
    for k, v in env_vars.items():
        if k not in keys_written:
            lines.append(f"{k}={v}")

    ENV_FILE.write_text("\n".join(lines) + "\n")
    print(f"\n  \033[92m✓ Saved to {ENV_FILE}\033[0m")
    print(f"  Restart EVA to apply:  eva restart  or  /restart\n")


