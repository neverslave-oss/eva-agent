def cmd_stop():
    """Emergency stop — kill model server (free GPU), keep API alive.
    Mirrors the Telegram /stop handler (_handle_stop)."""
    print("\033[91m  🛑 Stopping model server — GPU freed. API stays up; /restart to bring it back.\033[0m")
    try:
        subprocess.call(["pkill", "-f", "src/model_server.py"], stderr=subprocess.DEVNULL)
        subprocess.call(["pkill", "-f", "kernel_evolving_model_server"], stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"  \033[93mStop request sent (daemon may be down): {e}\033[0m\n")
        return
    sock = Path("/tmp/kernel_evolving_model.sock")
    if sock.exists():
        try:
            sock.unlink()
        except Exception:
            pass
    print("  \033[90mGPU freed. Use `eva restart` or /restart to bring the model back.\033[0m\n")


def _endpoint_exists(path: str) -> bool:
    """Lightweight probe: does an endpoint respond? Used for optional commands."""
    try:
        _get(path, timeout=4)
        return True
    except Exception:
        return False


def _request(method: str, path: str, body: dict = None, timeout: int = 30):
    """Generic HTTP request helper (supports GET/POST/DELETE)."""
    url = f"{API_BASE}{path}"
    req = urllib.request.Request(url, method=method)
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
        req.data = data
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
        if not raw:
            return {}
        try:
            return json.loads(raw)
        except Exception:
            return {"raw": raw.decode(errors="replace")[:200]}



# ── Chat ──────────────────────────────────────────────────────────────────────

def chat(message: str) -> str:
    try:
        resp = _post("/message", {"message": message}, timeout=120)
        return resp.get("reply", resp.get("response", resp.get("result", str(resp))))
    except urllib.error.URLError as e:
        return f"\033[91m[EVA unreachable: {e}]\033[0m"
    except Exception as e:
        return f"\033[91m[error: {e}]\033[0m"


def dispatch(cmd: str, rest: str = "") -> bool:
    """Dispatch a slash command or sub-command. Returns True if handled."""
    c = cmd.lstrip("/").lower().strip()
    if c in ("exit", "quit"):
        return "exit"
    elif c == "help":
        print(REPL_HELP)
    elif c == "status":
        cmd_status()
    elif c == "skills":
        cmd_skills()
    elif c == "routines":
        cmd_routines()
    elif c == "evolve":
        cmd_evolve(rest)
    elif c == "dash":
        cmd_dash()
    elif c == "model":
        cmd_model(rest)
    elif c == "thoughts":
        cmd_thoughts()
    elif c == "log":
        cmd_log()
    elif c == "memory":
        cmd_memory()
    elif c == "new":
        cmd_new()
    elif c == "version":
        cmd_version()
    elif c == "restart":
        cmd_restart()
    elif c == "update":
        cmd_update()
    elif c in ("telegram", "channels telegram"):
        cmd_telegram()
    elif c == "mobile":
        cmd_mobile()
    elif c == "init":
        cmd_init(rest)
    elif c == "packages":
        cmd_packages()
    elif c == "system":
        cmd_system()
    elif c == "provider":
        cmd_provider(rest)
    elif c in ("models", "model"):
        if c == "models":
            cmd_models(rest)
        else:
            cmd_model(rest)
    elif c == "replica":
        cmd_replica(rest)
    elif c == "workspaces":
        cmd_workspaces()
    elif c == "voices":
        cmd_voices()
    elif c in ("backup", "backups"):
        cmd_backup(rest)
    elif c == "rollback":
        cmd_rollback()
    elif c == "verbose":
        cmd_verbose(rest)
    elif c == "stop":
        cmd_stop()
    else:
        return False
    return True


