def cmd_replica(subcmd: str = ""):
    """Manage agent replicas. Mirrors /replica."""
    if not _require_running():
        return
    parts = subcmd.strip().split()
    action = parts[0] if parts else "list"
    try:
        if action == "list":
            reps = _get("/replica/active", timeout=8)
            active = [r for r in reps if isinstance(r, dict) and r.get("name")]
            print(f"\n\033[96m  Active replicas ({len(active)}):\033[0m")
            if not active:
                print("  (none)")
            for r in active:
                print(f"    \033[92m{r.get('name')}\033[0m  role={r.get('role')}  done={r.get('done')}  persistent={r.get('persistent')}")
                if r.get("task"):
                    print(f"      task: {str(r['task'])[:70]}")
            print()
        elif action == "spawn":
            if len(parts) < 2:
                print("  Usage: replica spawn <name> [role=worker]\n")
                return
            name = parts[1]
            role = next((p.split("=", 1)[1] for p in parts[2:] if p.startswith("role=")), "worker")
            resp = _post("/replica/named", {"name": name, "role": role}, timeout=30)
            print(f"\n\033[92m  Spawned: {name}\033[0m  {resp}\n")
        elif action == "status":
            if len(parts) < 2:
                print("  Usage: replica status <name>\n")
                return
            name = parts[1]
            try:
                resp = _get(f"/replica/{name}/status", timeout=8)
            except urllib.error.HTTPError:
                print(f"\033[91m  Replica '{name}' not found.\033[0m\n")
                return
            print(f"\n\033[96m  Replica {name}:\033[0m")
            for k, v in resp.items():
                print(f"  {k}: {v}")
            print()
        elif action == "stop":
            if len(parts) < 2:
                print("  Usage: replica stop <name>\n")
                return
            name = parts[1]
            try:
                resp = _request("DELETE", f"/replica/{name}", timeout=8)
                print(f"\n\033[93m  Stopped replica: {name}\033[0m  {resp}\n")
            except urllib.error.HTTPError:
                print(f"\033[91m  Replica '{name}' not found.\033[0m\n")
        else:
            print(f"  Unknown replica sub-command: '{action}'. Use: list | spawn <name> | status <name> | stop <name>\n")
    except Exception as e:
        print(f"\033[91m  Error: {e}\033[0m\n")


