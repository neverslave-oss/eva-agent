def cmd_dash():
    """Open evolution dashboard in browser."""
    url = f"{API_BASE}/evolution/dashboard"
    print(f"\033[96m  Opening dashboard:\033[0m {url}")
    try:
        # Check it's available first
        import urllib.request as _ur
        _ur.urlopen(_ur.Request(url), timeout=4).read()
    except Exception:
        if not _require_running():
            return
    # Try to open in browser
    opened = False
    for cmd in [
        ["xdg-open", url],
        ["wslview", url],
        ["explorer.exe", url],
        ["open", url],
    ]:
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            opened = True
            break
        except FileNotFoundError:
            continue
    if not opened:
        print(f"  Could not auto-open. Navigate to:  \033[92m{url}\033[0m")
    else:
        print(f"  \033[92m✓ Opened in browser\033[0m")
