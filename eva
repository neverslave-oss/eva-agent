def load_history():
    try:
        readline.read_history_file(str(HISTORY_FILE))
    except FileNotFoundError:
        pass


def save_history():
    readline.write_history_file(str(HISTORY_FILE))
    readline.set_history_length(500)


def print_header():
    print(BANNER)
    try:
        h = _get("/health", timeout=3)
        v = _get("/version", timeout=2).get("version", "?")
        vram = h.get("vram_free_mb", "?")
        skills_n = h.get("skills", "?")
        print(f"\033[90m  v{v} · {skills_n} skills · {vram} MB VRAM free · {API_BASE}\033[0m")
    except Exception:
        print(f"\033[91m  ⚠ EVA not running at {API_BASE}\033[0m")
        print(f"\033[90m  Start with:  bash {REPO_DIR}/start.sh\033[0m")
    print(f"\033[90m  Type /help for commands · Ctrl+C to exit\033[0m\n")


def run_interactive():
    load_history()
    print_header()

    while True:
        try:
            user_input = input("\033[92mYou:\033[0m ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n\033[90mBye.\033[0m")
            save_history()
            break

        if not user_input:
            continue

        # Slash command or sub-command
        if user_input.startswith("/") or user_input.split()[0].lower() in (
            "status", "skills", "routines", "evolve", "dash", "model",
            "models", "provider", "replica", "workspaces", "voices",
            "packages", "system", "backup", "rollback", "verbose", "init",
            "thoughts", "log", "memory", "new", "version", "restart",
            "update", "telegram", "mobile", "stop", "help", "exit", "quit",
        ):
            parts = user_input.lstrip("/").split(None, 1)
            result = dispatch(parts[0], parts[1] if len(parts) > 1 else "")
            if result == "exit":
                save_history()
                break
            if result is False:
                # Unknown slash command — send to agent
                reply = chat(user_input)
                print(f"\033[96mEVA:\033[0m {reply}\n")
        else:
            reply = chat(user_input)
            print(f"\033[96mEVA:\033[0m {reply}\n")


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="eva",
        description="EVA — kernel-evolving self-evolving local AI agent CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
        add_help=False,  # We handle -h ourselves for cleaner output
    )
    parser.add_argument("-h", "--help", action="store_true", help="Show help and exit")
    parser.add_argument("-c", "--channel", metavar="CHANNEL", help="Configure a channel (e.g. telegram)")
    parser.add_argument("--api", metavar="URL", help="Override API base URL")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="Command or message")

    opts = parser.parse_args()

    # API override
    global API_BASE
    if opts.api:
        API_BASE = opts.api

    # -h / --help
    if opts.help:
        print(__doc__)
        return

    # -c <channel>
    if opts.channel:
        ch = opts.channel.lower()
        if ch == "telegram":
            cmd_telegram()
        elif ch == "mobile":
            cmd_mobile()
        else:
            print(f"\033[91m  Unknown channel: {ch}\033[0m")
            print(f"  Available: telegram, mobile\n")
        return

    # Positional args
    args = opts.args
    if not args:
        run_interactive()
        return

    # Join first token + rest
    first = args[0].lstrip("/").lower()
    rest = " ".join(args[1:])

    result = dispatch(first, rest)
    if result is False:
        # Not a command — treat as one-shot chat
        message = " ".join(opts.args)
        if not _alive():
            print(f"\033[91mEVA not running at {API_BASE}. Start with: bash {REPO_DIR}/start.sh\033[0m")
            sys.exit(1)
        reply = chat(message)
        print(reply)


if __name__ == "__main__":
    main()
