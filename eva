# ── HTTP ─────────────────────────────────────────────────────────────────────

def _get(path: str, timeout: int = 8) -> dict:
    url = f"{API_BASE}{path}"
    with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as r:
        return json.loads(r.read())


def _post(path: str, body: dict = None, timeout: int = 120) -> dict:
    url = f"{API_BASE}{path}"
    data = json.dumps(body or {}).encode()
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _alive() -> bool:
    try:
        _get("/health", timeout=3)
        return True
    except Exception:
        return False


def _require_running():
    if not _alive():
        print(f"\033[91m  EVA not running at {API_BASE}\033[0m")
        print(f"  Start with:  bash {REPO_DIR}/start.sh")
        print(f"  Or override: EVA_API=http://host:8779 eva\n")
        return False
    return True

# ── Commands ─────────────────────────────────────────────────────────────────

def cmd_status():
    try:
        h = _get("/health")
        v = _get("/version", timeout=4).get("version", "?")
        print(f"\n\033[96m  EVA Status\033[0m  \033[90mv{v}\033[0m")
        print(f"  API:      \033[92m{API_BASE}\033[0m  (\033[92m●\033[0m online)")
        print(f"  VRAM:     {h.get('vram_free_mb', '?')} MB free")
        print(f"  Skills:   {h.get('skills', '?')}")
        print(f"  Routines: {h.get('routines', '?')}")
        if h.get("active_replicas"):
            print(f"  Replicas: {h['active_replicas']}")
        try:
            p = _get("/provider", timeout=4)
            routing = p.get("routing", {})
            local_model = routing.get("task_inference", {}).get("model") or "local"
            synth = routing.get("synthesis", {}).get("provider", "?")
            print(f"  Inference:{local_model}")
            print(f"  Synthesis: {synth}")
        except Exception:
            pass
        print()
    except Exception as e:
        print(f"\033[91m  EVA not reachable at {API_BASE}\033[0m")
        print(f"  Start:  bash {REPO_DIR}/start.sh\n")


def cmd_skills():
    if not _require_running():
        return
    try:
        skills = _get("/skills")
        core = [s for s in skills if s.get("is_core")]
        rest = [s for s in skills if not s.get("is_core")]
        print(f"\n\033[96m  Skills ({len(skills)}):\033[0m")
        if core:
            print(f"  \033[93m── Core (always pre-installed) ──\033[0m")
            for s in core:
                cmds = "  ".join(s.get("commands", []))
                print(f"  \033[92m★ {s['name']}\033[0m  —  {s.get('description','')[:58]}")
                if cmds:
                    print(f"    \033[90mcommands: {cmds}\033[0m")
        if rest:
            tiers = {}
            for s in rest:
                t = s.get("tier", "installed")
                tiers.setdefault(t, []).append(s)
            for tier, ss in sorted(tiers.items()):
                label = {"community":"Community","private":"Private","third-party":"3rd-party"}.get(tier, tier.title())
                print(f"  \033[90m── {label} ({len(ss)}) ──\033[0m")
                for s in ss[:25]:
                    print(f"    \033[92m{s['name']}\033[0m  —  {s.get('description','')[:58]}")
                if len(ss) > 25:
                    print(f"    \033[90m… and {len(ss)-25} more\033[0m")
        print()
    except Exception as e:
        print(f"\033[91m  Error: {e}\033[0m\n")


def cmd_routines():
