# ── Chat ──────────────────────────────────────────────────────────────────────

def chat(message: str) -> str:
    try:
        resp = _post("/message", {"message": message}, timeout=120)
        return resp.get("reply", resp.get("response", resp.get("result", str(resp))))
    except urllib.error.URLError as e:
        return f"\033[91m[EVA unreachable: {e}]\033[0m"
    except Exception as e:
        return f"\033[91m[error: {e}]\033[0m"


def dispatch(cmd: str, rest: str = "") -> bool:
    """Dispatch a slash command or sub-command. Returns True if handled."""
    c = cmd.lstrip("/").lower().strip()
    if c in ("exit", "quit"):
        return "exit"
    elif c == "help":
        print(REPL_HELP)
    elif c == "status":
        cmd_status()
    elif c == "skills":
        cmd_skills()
    elif c == "routines":
        cmd_routines()
    elif c == "evolve":
        cmd_evolve(rest)
    elif c == "dash":
        cmd_dash()
    elif c == "model":
        cmd_model(rest)
    elif c == "thoughts":
        cmd_thoughts()
    elif c == "log":
        cmd_log()
    elif c == "memory":
        cmd_memory()
    elif c == "new":
        cmd_new()
    elif c == "version":
        cmd_version()
    elif c == "restart":
        cmd_restart()
    elif c == "update":
        cmd_update()
    elif c in ("telegram", "channels telegram"):
        cmd_telegram()
    elif c == "mobile":
        cmd_mobile()
    else:
        return False
    return True


# ── REPL ──────────────────────────────────────────────────────────────────────

def load_history():
    try:
        readline.read_history_file(str(HISTORY_FILE))
    except FileNotFoundError:
        pass


def save_history():
    readline.write_history_file(str(HISTORY_FILE))
    readline.set_history_length(500)


def print_header():
    print(BANNER)
    try:
        h = _get("/health", timeout=3)
        v = _get("/version", timeout=2).get("version", "?")
        vram = h.get("vram_free_mb", "?")
        skills_n = h.get("skills", "?")
        print(f"\033[90m  v{v} · {skills_n} skills · {vram} MB VRAM free · {API_BASE}\033[0m")
    except Exception:
        print(f"\033[91m  ⚠ EVA not running at {API_BASE}\033[0m")
        print(f"\033[90m  Start with:  bash {REPO_DIR}/start.sh\033[0m")
    print(f"\033[90m  Type /help for commands · Ctrl+C to exit\033[0m\n")


def run_interactive():
    load_history()
    print_header()

    while True:
        try:
            user_input = input("\033[92mYou:\033[0m ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n\033[90mBye.\033[0m")
            save_history()
            break

        if not user_input:
            continue

        # Slash command or sub-command
        if user_input.startswith("/") or user_input.split()[0].lower() in (
            "status", "skills", "routines", "evolve", "dash", "model",
            "thoughts", "log", "memory", "new", "version", "restart",
            "update", "telegram", "mobile", "help", "exit", "quit",
        ):
            parts = user_input.lstrip("/").split(None, 1)
            result = dispatch(parts[0], parts[1] if len(parts) > 1 else "")
            if result == "exit":
                save_history()
                break
            if result is False:
                # Unknown slash command — send to agent
                reply = chat(user_input)
                print(f"\033[96mEVA:\033[0m {reply}\n")
        else:
            reply = chat(user_input)
            print(f"\033[96mEVA:\033[0m {reply}\n")


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="eva",
        description="EVA — kernel-evolving self-evolving local AI agent CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
        add_help=False,  # We handle -h ourselves for cleaner output
    )
    parser.add_argument("-h", "--help", action="store_true", help="Show help and exit")
    parser.add_argument("-c", "--channel", metavar="CHANNEL", help="Configure a channel (e.g. telegram)")
    parser.add_argument("--api", metavar="URL", help="Override API base URL")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="Command or message")

    opts = parser.parse_args()

    # API override
    global API_BASE
    if opts.api:
        API_BASE = opts.api

    # -h / --help
    if opts.help:
        print(__doc__)
        return

    # -c <channel>
    if opts.channel:
        ch = opts.channel.lower()
        if ch == "telegram":
            cmd_telegram()
        elif ch == "mobile":
            cmd_mobile()
        else:
            print(f"\033[91m  Unknown channel: {ch}\033[0m")
            print(f"  Available: telegram, mobile\n")
        return

    # Positional args
    args = opts.args
    if not args:
        run_interactive()
        return

    # Join first token + rest
    first = args[0].lstrip("/").lower()
    rest = " ".join(args[1:])

    result = dispatch(first, rest)
    if result is False:
        # Not a command — treat as one-shot chat
        message = " ".join(opts.args)
        if not _alive():
