def cmd_provider(subcmd: str = ""):
    """Show provider routing table (mirrors /provider) or set a role mapping."""
    if not _require_running():
        return
    parts = subcmd.strip().split()
    if parts and parts[0] == "set":
        if len(parts) < 3:
            print("  Usage: provider set <role> <provider> [model]  e.g. provider set task_inference hf\n")
            return
        role = parts[1]
        prov = parts[2]
        model = parts[3] if len(parts) > 3 else None
        body = {role: {"provider": prov}}
        if model:
            body[role]["model"] = model
        try:
            resp = _post("/provider/set", body, timeout=10)
            print(f"\n\033[92m  Provider set: {role} → {prov}\033[0m  {resp}\n")
        except Exception as e:
            print(f"\033[91m  Error: {e}\033[0m\n")
        return
    try:
        p = _get("/provider", timeout=6)
        routing = p.get("routing", {})
        print(f"\n\033[96m  Provider routing table:\033[0m")
        if not routing:
            print("  (empty)")
