def cmd_restart():
    print("\033[93m  Restarting EVA daemon...\033[0m")
    proc = subprocess.Popen(
        ["bash", str(REPO_DIR / "start.sh")],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
