        print(f"\033[91m  Error: {e}\033[0m\n")


def cmd_evolve(subcmd: str = ""):
    if not _require_running():
        return
    sub = subcmd.strip().lower()
    try:
        if sub == "status":
            resp = _get("/evolution/state", timeout=8)
            print(f"\n\033[96m  Evolution state:\033[0m")
            for k, v in resp.items():
                print(f"  {k}: {v}")
        elif sub in ("stop", "pause"):
            resp = _post("/evolution/control", {"action": "stop"}, timeout=10)
            print(f"\n\033[93m  Evolution stopped.\033[0m  {resp}")
        elif sub == "":
            resp = _post("/evolution/trigger", {}, timeout=30)
            print(f"\n\033[92m  Evolution triggered.\033[0m")
            for k, v in resp.items():
                print(f"  {k}: {v}")
        else:
            print(f"  Unknown evolve sub-command: '{sub}'. Use: evolve | evolve status | evolve stop")
        print()
    except Exception as e:
        print(f"\033[91m  Evolve error: {e}\033[0m\n")


def cmd_dash():
    """Open evolution dashboard in browser."""
    url = f"{API_BASE}/evolution/dashboard"
    print(f"\033[96m  Opening dashboard:\033[0m {url}")
    try:
        # Check it's available first
        import urllib.request as _ur
        _ur.urlopen(_ur.Request(url), timeout=4).read()
    except Exception:
        if not _require_running():
            return
    # Try to open in browser
    opened = False
    for cmd in [
        ["xdg-open", url],
        ["wslview", url],
        ["explorer.exe", url],
        ["open", url],
    ]:
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            opened = True
            break
        except FileNotFoundError:
            continue
    if not opened:
        print(f"  Could not auto-open. Navigate to:  \033[92m{url}\033[0m")
    else:
        print(f"  \033[92m✓ Opened in browser\033[0m")
    print()


def cmd_model(subcmd: str = ""):
    if not _require_running():
        return
    parts = subcmd.strip().split()
    if parts and parts[0] == "set":
        if len(parts) < 2:
            print("  Usage: model set <provider>  (local | openai | anthropic | copilot)\n")
            return
        provider = parts[1]
        try:
            resp = _post("/provider/set", {"provider": provider}, timeout=10)
            print(f"\n\033[92m  Provider set to: {provider}\033[0m  {resp}\n")
        except Exception as e:
            print(f"\033[91m  Error: {e}\033[0m\n")
        return
    try:
        p = _get("/provider", timeout=6)
        avail = _get("/provider/available", timeout=6)
        routing = p.get("routing", {})
        print(f"\n\033[96m  Model / Provider Routing:\033[0m")
        for role, cfg in routing.items():
            prov = cfg.get("provider", "?")
            model = cfg.get("model") or "(default)"
            streaming = "stream" if cfg.get("streaming") else "batch"
            print(f"  {role:<22} {prov:<12} {model:<30} {streaming}")
        providers = avail if isinstance(avail, list) else avail.get("providers", [])
        if providers:
            print(f"\n  \033[90mAvailable providers: {', '.join(str(p) for p in providers)}\033[0m")
            print(f"  To switch:  eva model set <provider>  or  /model set <provider>")
        print()
    except Exception as e:
        print(f"\033[91m  Error: {e}\033[0m\n")


