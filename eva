        return
    try:
        routines = _get("/routines")
        print(f"\n\033[96m  Routines ({len(routines)}):\033[0m")
        for r in routines:
            t = r.get("trigger", {})
            trigger_hint = ""
            if isinstance(t, dict):
                trigger_hint = t.get("also", t.get("cron", t.get("type", "")))
            print(f"  \033[93m{r['name']}\033[0m  —  {r.get('description','')[:60]}  \033[90m{trigger_hint}\033[0m")
