def cmd_rollback():
    """Rollback to previous version (git reset HEAD~1 + restart).

    Mirrors the authoritative Telegram /rollback handler (_handle_rollback), which
    runs `git reset --hard HEAD~1` locally and restarts via start.sh — there is no
    API endpoint for this, so we do the same local operation."""
    print("\033[93m  Rolling back to previous version...\033[0m")
    try:
        r = subprocess.run(
            ["git", "reset", "--hard", "HEAD~1"],
            cwd=str(REPO_DIR),
            capture_output=True,
            text=True,
            timeout=30,
        )
        print(f"  git reset: {(r.stdout or '').strip()}{(r.stderr or '').strip()}")
    except Exception as e:
        print(f"\033[91m  Rollback failed: {e}\033[0m\n")
        return
    print("\033[93m  Rolled back. Restarting daemon...\033[0m")
    cmd_restart()

